# Go network engine configuration.
# Copy to backend/.env and fill in the values. Real environment variables win.

# Must match the Laravel APP_KEY: router credentials are decrypted with it.
APP_KEY=
APP_TIMEZONE=Africa/Nairobi

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mikrotik-api
DB_USERNAME=root
DB_PASSWORD=
# Optional full DSN, overrides the DB_* values above:
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/mikrotik-api

# Loopback only. Generate a long random value: openssl rand -hex 32
ENGINE_HTTP_ADDR=127.0.0.1:8080
ENGINE_TOKEN=

ENGINE_SWEEP_INTERVAL=60s
ENGINE_ROUTER_TIMEOUT=5s
ENGINE_CONCURRENCY=8
ENGINE_RUN_ON_START=true
ENGINE_LOG_LEVEL=info

# Leave empty to use expired_profile_name from main_site_data.
ENGINE_EXPIRED_PROFILE=

# Billing-driven PPP suspension. Keep false until the PHP user-disable
# schedule has been removed (see README).
ENGINE_PPP_AUTODISABLE=false
